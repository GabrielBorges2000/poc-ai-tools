generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// DOCUMENT ANALYSIS TABLES
// ============================================================

model DocumentType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  fields      String // JSON with expected fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("document_type")
}

model ProcessingLog {
  id             Int      @id @default(autoincrement())
  documentName   String
  fileType       String
  fileSize       Int
  status         String // SUCCESS, ERROR, PENDING
  processingTime Int // milliseconds
  tokensUsed     Int      @default(0)
  modelUsed      String
  result         String? // CORRETO, INCORRETO, ERRO
  description    String?
  validate       String?
  fieldErrors    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("processing_log")
}
