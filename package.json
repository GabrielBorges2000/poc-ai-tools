{
  "name": "poc-ai-tools",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm env:load tsx watch src/server.ts",
    "db:migrate": "pnpm env:load prisma migrate dev",
    "db:reset": "pnpm env:load prisma migrate reset && pnpm run db:seed",
    "db:generate": "pnpm env:load prisma generate",
    "db:deploy": "pnpm env:load prisma migrate deploy",
    "db:push": "pnpm env:load prisma db push",
    "db:validate": "pnpm env:load prisma validate",
    "db:studio": "pnpm env:load prisma studio",
    "db:seed": "pnpm env:load tsx prisma/seed.ts",
    "env:load": "dotenv -e .env --",
    "build": "pnpm env:load tsup",
    "start": "pnpm env:load node dist/server.js",
    "format": "biome format --write",
    "lint": "biome lint --write",
    "check": "biome check --write"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/client": "5.12.1",
    "@scalar/fastify-api-reference": "^1.34.0",
    "ai": "^5.0.106",
    "ai-sdk-ollama": "^1.0.2",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.12",
    "dotenv": "^17.2.3",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^5.0.2",
    "ollama-ai-provider-v2": "^1.5.5",
    "pdf-parse": "^2.4.5",
    "resend": "^4.6.0",
    "sharp": "^0.34.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.3",
    "@faker-js/faker": "^8.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.6",
    "dotenv-cli": "^7.4.1",
    "prisma": "^5.12.1",
    "tsup": "^8.2.4",
    "tsx": "^4.7.2"
  }
}
